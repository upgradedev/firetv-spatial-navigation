{
  "name": "@upgradedev/firetv-spatial-navigation",
  "version": "0.1.0",
  "description": "Dependency-free geometric D-pad navigation for Fire TV and television web views.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "examples",
    "CONTRIBUTING.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "node --check src/index.js && node --check test/spatial-navigation.test.js",
    "pack:check": "npm pack --dry-run --json"
  },
  "keywords": [
    "fire-tv",
    "d-pad",
    "spatial-navigation",
    "ten-foot-ui",
    "android-tv",
    "vega-os"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upgradedev/firetv-spatial-navigation.git"
  },
  "homepage": "https://github.com/upgradedev/firetv-spatial-navigation#readme",
  "bugs": {
    "url": "https://github.com/upgradedev/firetv-spatial-navigation/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
